<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

    <!-- ===== Launch e modelo de debug (issue 13) ===== -->

    <!-- Só dá nome à Sessão de debug na view Debug: o launch sai do comando "Depurar Rotina". -->
    <extension point="org.eclipse.debug.core.launchConfigurationTypes">
        <launchConfigurationType
                id="dev.fbdebug.dbeaver.launchType"
                name="Firebird PSQL"
                delegate="dev.fbdebug.dbeaver.debug.PsqlLaunchDelegate"
                modes="debug"
                public="false"/>
    </extension>

    <!-- Rótulos, detalhe dos valores e o editor da linha da pausa (issue 14). -->
    <extension point="org.eclipse.debug.ui.debugModelPresentations">
        <debugModelPresentation
                id="dev.fbdebug.dbeaver.psql"
                class="dev.fbdebug.dbeaver.editor.PsqlModelPresentation"/>
    </extension>

    <!-- Watches da view Expressions, avaliados no servidor com as variáveis do frame selecionado (issue 16). -->
    <extension point="org.eclipse.debug.core.watchExpressionDelegates">
        <watchExpressionDelegate
                debugModel="dev.fbdebug.dbeaver.psql"
                delegateClass="dev.fbdebug.dbeaver.debug.PsqlWatchExpressionDelegate"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="dev.fbdebug.dbeaver.debugRoutine"
                name="Depurar Rotina"
                description="Inicia uma Sessão de debug da Rotina Firebird"/>
        <command
                id="dev.fbdebug.dbeaver.rulerToggleBreakpoint"
                name="Alternar Breakpoint"
                description="Alterna o breakpoint da linha clicada no ruler do editor de Rotina Firebird"/>
        <command
                id="dev.fbdebug.dbeaver.openPackage"
                name="Abrir Package..."
                description="Mostra o corpo de uma package Firebird num console, para depurar as rotinas dela"/>
    </extension>

    <extension point="org.eclipse.core.expressions.propertyTesters">
        <propertyTester
                id="dev.fbdebug.dbeaver.routineEditorTester"
                type="java.lang.Object"
                namespace="dev.fbdebug.dbeaver"
                properties="breakpointSource"
                class="dev.fbdebug.dbeaver.editor.RoutineEditorTester"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- Antes de o plugin carregar, vale esta expressão; depois, o handler confere a Rotina de fato. O plugin do
             Firebird do DBeaver não exporta FireBirdProcedure nem FireBirdTableTrigger (a trigger de banco é outra
             classe), mas a expressão compara só o nome da classe. O navegador do DBeaver adapta o nó a DBSProcedure e
             a DBSObject, mas não a DBSTrigger. No editor SQL (EXECUTE BLOCK, console de package), o handler confere se
             a conexão é Firebird. -->
        <handler
                commandId="dev.fbdebug.dbeaver.debugRoutine"
                class="dev.fbdebug.dbeaver.launch.DebugRoutineHandler">
            <enabledWhen>
                <or>
                    <with variable="selection">
                        <instanceof value="org.eclipse.jface.viewers.IStructuredSelection"/>
                        <count value="1"/>
                        <iterate operator="and">
                            <or>
                                <adapt type="org.jkiss.dbeaver.model.struct.rdb.DBSProcedure">
                                    <instanceof value="org.jkiss.dbeaver.ext.firebird.model.FireBirdProcedure"/>
                                </adapt>
                                <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                                    <instanceof value="org.jkiss.dbeaver.ext.firebird.model.FireBirdTableTrigger"/>
                                </adapt>
                            </or>
                        </iterate>
                    </with>
                    <with variable="activeEditorInput">
                        <instanceof value="org.jkiss.dbeaver.ui.editors.IDatabaseEditorInput"/>
                    </with>
                    <with variable="activeEditor">
                        <instanceof value="org.jkiss.dbeaver.ui.editors.sql.SQLEditor"/>
                    </with>
                </or>
            </enabledWhen>
        </handler>
        <!-- O handler confere se há conexão Firebird no contexto (navegador ou editor ativo). -->
        <handler
                commandId="dev.fbdebug.dbeaver.openPackage"
                class="dev.fbdebug.dbeaver.launch.OpenPackageHandler"/>
        <!-- Ctrl+Shift+B: o debug.ui só liga o comando a um handler pelo breakpointActionSet, que o DBeaver não
             exibe. Ativo só no editor de objeto de Rotina Firebird e no editor SQL de conexão Firebird, para não tomar
             o comando de outros debuggers. O teste é sobre o editor, e não sobre activeEditorInput, que fica com a
             entrada provisória de um editor restaurado (RoutineEditorTester). -->
        <handler
                commandId="org.eclipse.debug.ui.commands.ToggleBreakpoint"
                class="dev.fbdebug.dbeaver.editor.ToggleBreakpointHandler">
            <activeWhen>
                <and>
                    <with variable="activePartId">
                        <or>
                            <equals value="org.jkiss.dbeaver.ui.editors.entity.EntityEditor"/>
                            <equals value="org.jkiss.dbeaver.ui.editors.sql.SQLEditor"/>
                        </or>
                    </with>
                    <with variable="activeEditor">
                        <test property="dev.fbdebug.dbeaver.breakpointSource" forcePluginActivation="true"/>
                    </with>
                </and>
            </activeWhen>
        </handler>
        <handler
                commandId="dev.fbdebug.dbeaver.rulerToggleBreakpoint"
                class="dev.fbdebug.dbeaver.editor.RulerToggleBreakpointHandler">
            <enabledWhen>
                <with variable="activeEditor">
                    <test property="dev.fbdebug.dbeaver.breakpointSource" forcePluginActivation="true"/>
                </with>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
            <menu id="dev.fbdebug.dbeaver.menu" label="PSQL Debug">
                <command commandId="dev.fbdebug.dbeaver.debugRoutine"/>
                <command commandId="dev.fbdebug.dbeaver.openPackage"/>
            </menu>
        </menuContribution>
        <!-- Menu de contexto do navegador: só aparece com a Rotina Firebird (de trigger, só a de tabela). O grupo
             generate só existe nos menus que o DBeaver monta com o NavigatorUtils; no texto da pasta Source o item vem
             da contribuição seguinte. Não é checkEnabled: com uma view do debug ou o console em foco, o comando vale
             para o editor ativo (menu "PSQL Debug"), mas não deve aparecer no menu de contexto delas. -->
        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=generate">
            <command commandId="dev.fbdebug.dbeaver.debugRoutine">
                <visibleWhen>
                    <or>
                        <and>
                            <with variable="activePart">
                                <instanceof value="org.eclipse.ui.IEditorPart"/>
                            </with>
                            <with variable="activeEditor">
                                <not>
                                    <instanceof value="org.jkiss.dbeaver.ui.editors.sql.SQLEditor"/>
                                </not>
                                <test property="dev.fbdebug.dbeaver.breakpointSource" forcePluginActivation="true"/>
                            </with>
                        </and>
                        <and>
                            <with variable="activePart">
                                <not>
                                    <instanceof value="org.eclipse.ui.IEditorPart"/>
                                </not>
                            </with>
                            <with variable="selection">
                                <instanceof value="org.eclipse.jface.viewers.IStructuredSelection"/>
                                <count value="1"/>
                                <iterate operator="and">
                                    <or>
                                        <adapt type="org.jkiss.dbeaver.model.struct.rdb.DBSProcedure">
                                            <instanceof value="org.jkiss.dbeaver.ext.firebird.model.FireBirdProcedure"/>
                                        </adapt>
                                        <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                                            <instanceof
                                                    value="org.jkiss.dbeaver.ext.firebird.model.FireBirdTableTrigger"/>
                                        </adapt>
                                    </or>
                                </iterate>
                            </with>
                        </and>
                    </or>
                </visibleWhen>
            </command>
        </menuContribution>
        <!-- Menu de contexto do texto dos editores SQL do DBeaver (a pasta Source do editor de objeto e o editor SQL),
             que não tem o grupo generate. Só no editor de uma Rotina Firebird e no editor SQL de conexão Firebird. -->
        <menuContribution allPopups="false" locationURI="popup:#SQLEditorContext?after=additions">
            <command commandId="dev.fbdebug.dbeaver.debugRoutine">
                <visibleWhen>
                    <with variable="activeEditor">
                        <test property="dev.fbdebug.dbeaver.breakpointSource" forcePluginActivation="true"/>
                    </with>
                </visibleWhen>
            </command>
        </menuContribution>
        <!-- Menu de contexto do ruler dos editores SQL do DBeaver. -->
        <menuContribution allPopups="false" locationURI="popup:#SQLRulerContext?before=additions">
            <command commandId="dev.fbdebug.dbeaver.rulerToggleBreakpoint">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>
    </extension>

    <!-- ===== Breakpoints de linha (issue 14) ===== -->

    <!-- Não persistente: o breakpoint existe só enquanto o editor da Rotina está aberto (ADR 0004). -->
    <extension point="org.eclipse.core.resources.markers"
               id="lineBreakpointMarker"
               name="Firebird PSQL breakpoint">
        <super type="org.eclipse.debug.core.lineBreakpointMarker"/>
        <persistent value="false"/>
    </extension>

    <extension point="org.eclipse.debug.core.breakpoints">
        <breakpoint
                id="dev.fbdebug.dbeaver.lineBreakpoint"
                markerType="dev.fbdebug.dbeaver.lineBreakpointMarker"
                class="dev.fbdebug.dbeaver.debug.PsqlLineBreakpoint"
                name="Firebird PSQL breakpoint"/>
    </extension>

    <!-- ===== Step into e step return (issue 17) ===== -->

    <!-- F7 (step return) no editor SQL (console de package, EXECUTE BLOCK): o SQLEditor do DBeaver ativa sempre o
         contexto org.jkiss.dbeaver.ui.context.resultset, que liga F7 ao "toggle preview" da grade. Ele e o
         org.eclipse.debug.ui.debugging têm a mesma profundidade, e o E4 desempata pelo id, o que dá F7 ao DBeaver. Um
         contexto filho do debugging, ativo enquanto a Sessão de debug está selecionada na view Debug, ganha pela
         profundidade. F5, F6 e F8 não têm esse conflito. -->
    <extension point="org.eclipse.ui.contexts">
        <context
                id="dev.fbdebug.dbeaver.debugging"
                name="Depurando Firebird PSQL"
                parentId="org.eclipse.debug.ui.debugging"/>
    </extension>

    <extension point="org.eclipse.debug.ui.debugModelContextBindings">
        <modelContextBinding
                debugModelId="dev.fbdebug.dbeaver.psql"
                contextId="dev.fbdebug.dbeaver.debugging"/>
    </extension>

    <extension point="org.eclipse.ui.bindings">
        <key
                sequence="F7"
                contextId="dev.fbdebug.dbeaver.debugging"
                commandId="org.eclipse.debug.ui.commands.StepReturn"
                schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
    </extension>

    <!-- Aviso "executado no servidor" no nome de cada chamada sem step into do texto da Rotina, durante a Sessão de
         debug (ServerCallAnnotations). Sem marker: a anotação é posta e tirada à mão, como a marca do breakpoint. -->
    <extension point="org.eclipse.ui.editors.annotationTypes">
        <type name="dev.fbdebug.dbeaver.serverCall"/>
    </extension>

    <extension point="org.eclipse.ui.editors.markerAnnotationSpecification">
        <specification
                annotationType="dev.fbdebug.dbeaver.serverCall"
                label="Executado no servidor (Firebird PSQL Debugger)"
                symbolicIcon="info"
                presentationLayer="4"
                colorPreferenceKey="dev.fbdebug.dbeaver.serverCall.color"
                colorPreferenceValue="130,160,190"
                textPreferenceKey="dev.fbdebug.dbeaver.serverCall.text"
                textPreferenceValue="true"
                textStylePreferenceKey="dev.fbdebug.dbeaver.serverCall.textStyle"
                textStylePreferenceValue="DASHED_BOX"
                highlightPreferenceKey="dev.fbdebug.dbeaver.serverCall.highlight"
                highlightPreferenceValue="false"
                overviewRulerPreferenceKey="dev.fbdebug.dbeaver.serverCall.overviewRuler"
                overviewRulerPreferenceValue="true"
                verticalRulerPreferenceKey="dev.fbdebug.dbeaver.serverCall.verticalRuler"
                verticalRulerPreferenceValue="true"
                contributesToHeader="false"
                includeOnPreferencePage="true"/>
    </extension>

    <!-- Duplo-clique no ruler: o editor de texto da pasta Source do editor de procedure (site "generic.source.view")
         procura a ação RulerDoubleClick nas contribuições com o id do site dele, na hora do clique. A ação roda o
         comando de definitionId; a classe só valeria para um editor de primeiro nível com esse id, que não existe. -->
    <extension point="org.eclipse.ui.editorActions">
        <editorContribution
                id="dev.fbdebug.dbeaver.sourceRulerActions"
                targetID="generic.source.view">
            <action
                    id="dev.fbdebug.dbeaver.rulerDoubleClick"
                    label="Alternar Breakpoint"
                    actionID="RulerDoubleClick"
                    definitionId="dev.fbdebug.dbeaver.rulerToggleBreakpoint"
                    class="org.eclipse.debug.ui.actions.RulerToggleBreakpointActionDelegate"/>
        </editorContribution>
        <!-- O editor SQL do DBeaver é de primeiro nível: o workbench pode instanciar a classe da ação, que alterna o
             breakpoint só num editor de conexão Firebird (EXECUTE BLOCK, console de package). -->
        <editorContribution
                id="dev.fbdebug.dbeaver.sqlRulerActions"
                targetID="org.jkiss.dbeaver.ui.editors.sql.SQLEditor">
            <action
                    id="dev.fbdebug.dbeaver.sqlRulerDoubleClick"
                    label="Alternar Breakpoint"
                    actionID="RulerDoubleClick"
                    definitionId="dev.fbdebug.dbeaver.rulerToggleBreakpoint"
                    class="dev.fbdebug.dbeaver.editor.RulerToggleBreakpointAction"/>
        </editorContribution>
    </extension>

</plugin>
