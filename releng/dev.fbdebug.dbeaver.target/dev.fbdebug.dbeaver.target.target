<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<!-- Target platform compartilhada pelo build (Tycho) e pela IDE (PDE: abrir e clicar em "Set as Active Target Platform"). -->
<target name="DBeaver CE 26.0.2 + org.eclipse.debug.ui">
    <locations>
        <!-- Bundles da própria instalação do DBeaver (plataforma Eclipse 2026-03 / 4.39), na pasta padrão por usuário. -->
        <location path="${env_var:LOCALAPPDATA}/DBeaver/plugins" type="Directory"/>
        <!-- Só o org.eclipse.debug.ui, da release cujo debug.core é 3.23.200.v20251107-0507 (ADR 0004). -->
        <location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="slicer"
                  includeDependencyDepth="none" includeSource="false" type="InstallableUnit">
            <repository location="https://download.eclipse.org/eclipse/updates/4.39/R-4.39-202602260420"/>
            <unit id="org.eclipse.debug.ui" version="3.20.0.v20260209-1220"/>
        </location>
    </locations>
    <targetJRE path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21"/>
    <environment>
        <os>win32</os>
        <ws>win32</ws>
        <arch>x86_64</arch>
    </environment>
</target>
